# Square Credentials
# Copy this file to .env.local and fill in your values

# Environment: 'sandbox' or 'production'
SQUARE_ENV=sandbox

# Legacy: Direct seller token (for backward compatibility)
SQUARE_SELLER_ACCESS_TOKEN=<test_restaurant_access_token>
SQUARE_LOCATION_ID=<test_restaurant_location_id>

# OAuth Application Credentials (from Square Developer Dashboard)
SQUARE_APPLICATION_ID=<your_production_application_id>
SQUARE_SANDBOX_APPLICATION_ID=<your_sandbox_application_id>
SQUARE_APP_SECRET=<your_production_app_secret>
SQUARE_SANDBOX_APP_SECRET=<your_sandbox_app_secret>

# OAuth Redirect URI (your deployed URL)
OAUTH_REDIRECT_URI=https://your-railway-domain.up.railway.app/api/oauth/callback
