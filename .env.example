# Square Sandbox Credentials
# Copy this file to .env.local and fill in your values

SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=<your_integration_access_token>
SQUARE_SELLER_ACCESS_TOKEN=<test_restaurant_access_token>
SQUARE_LOCATION_ID=<test_restaurant_location_id>
SQUARE_APPLICATION_ID=<your_application_id>
