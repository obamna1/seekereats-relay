# DoorDash Credentials
DOORDASH_DEVELOPER_ID=your_developer_id_here
DOORDASH_KEY_ID=your_key_id_here
DOORDASH_SIGNING_SECRET=your_base64_signing_secret_here

# Relay Service
RELAY_SECRET=your_relay_secret_for_api_calls
PORT=3000
BASE_URL=https://your-app-url.com

# Twilio Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_API_SID=your_twilio_api_sid
TWILIO_PHONE_NUMBER=+1your_twilio_phone_number
TEST_PHONE_NUMBER=+1your_test_phone_number
# Set to true to enable real Twilio phone calls to restaurants (false = mock calls for testing)
ENABLE_PHONE_CALLS=false

# Solana Configuration
# Helius RPC endpoint for Solana DevNet (get API key from helius.dev)
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY
SOLANA_NETWORK=devnet
# Merchant wallet address that receives USDC payments
MERCHANT_WALLET_ADDRESS=your_merchant_wallet_address_here
# USDC Token Mint Address (DevNet: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU, MainNet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v)
USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Database (PostgreSQL)
# =====================
# OPTION 1: Railway (Recommended for development + production)
#   - Go to Railway dashboard → PostgreSQL → Variables → Copy DATABASE_URL
#   - Same database for local and production simplifies development
#
# OPTION 2: Local PostgreSQL (Docker)
#   docker run --name postgres-seekereats -e POSTGRES_PASSWORD=password -p 5432:5432 -d postgres
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/seekereats
#
DATABASE_URL=postgresql://user:password@localhost:5432/seekereats

# Node Environment
NODE_ENV=development

# Square Configuration
# =====================
# Environment: 'sandbox' or 'production'
SQUARE_ENV=sandbox

# Access token for your Square application
# Get from: Square Developer Dashboard → Applications → Your App → Access Token
SQUARE_ACCESS_TOKEN=your_square_access_token

# Location ID for orders
# Get from: Square Developer Dashboard → Locations
SQUARE_LOCATION_ID=your_location_id

# Company card token for placing orders
# Generate by tokenizing a card via Square Web Payments SDK
# Sandbox: Use 'cnon:card-nonce-ok' for testing
COMPANY_CARD_TOKEN=cnon:card-nonce-ok

# Solana Configuration
# =====================
# RPC URL for Solana network (devnet for testing, mainnet for production)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Wallet address that receives Solana payments (your company wallet)
SOLANA_PAYMENT_WALLET=<your_solana_wallet_address>


